# Auto detect text files and perform LF normalization
* text=auto

# Python
*.py text diff=python eol=lf

# Web
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf

# Rust
*.rs text diff=rust eol=lf
*.toml text eol=lf

# Windows-specific
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary
*.pyd binary
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.safetensors binary
*.wav binary
*.mp4 binary
*.exe binary
*.bin binary
